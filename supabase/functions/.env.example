# Local Supabase Edge Function secrets.
# Copy to supabase/functions/.env for local `supabase functions serve`.
# For hosted functions, add these values in Supabase Dashboard > Edge Functions > Secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Cookidea <your-email@gmail.com>
